<!DOCTYPE html>
<html lang="{{ Culture.Name }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{{ "PageTitle" | shape_new | shape_stringify }}</title>
    {% resources type: "Meta" %}

    <!-- Favicon -->
    {% assign faviconUrl = "~/mediatheme/images/favicon.ico" | href %}
    {% link src:faviconUrl %}

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    <!-- JQuery and script links -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    {% assign scriptUrl = "~/mediatheme/js/site.js" | href %}
    {% script src:scriptUrl %}
    <!-- Custom theme CSS -->
    {% assign styleUrl = "~/mediatheme/styles/site.css" | href %}
    {% style src:styleUrl %}

    {% resources type: "HeadScript" %}
    {% resources type: "HeadLink" %}
    {% resources type: "Stylesheet" %}
    {% render_section "HeadMeta", required: false %}
</head>
<body>
    <div id="layout-wrapper">

        <!-- ===== Header ===== -->
        <div id="header">
            <!-- ===== Logo ===== -->
            <a class="site-logo" href="{{ '~/' | href }}" aria-label="Silver Lining Computing">
                {% assign logoUrl = "~/mediatheme/images/logo.png" | href %}
                <img src="{{ logoUrl }}" alt="Silver Lining Computing">
            </a>
            <!-- ===== Hamburger Toggle (hidden on desktop via CSS) ===== -->
            <div class="nav-toggle" role="button" aria-label="Toggle navigation" tabindex="0">
                <div class="nav-toggle-bar"></div>
            </div>

            <!-- ===== Navigation ===== -->
            <div id="menucontainer">
                {% shape "menu", alias: "alias:main-menu", cache_id: "main-menu", cache_fixed_duration: "00:05:00", cache_tag: "alias:main-menu", cache_context: "user.roles" %}
            </div>
        </div>

        <!-- ===== Main Layout ===== -->
        <div id="layout-main-container">
            <div id="layout-main">

                <div id="layout-content">
                    <div id="content">
                        {% render_body %}
                    </div>
                </div>
                <!-- ===== Right Sidebar ===== -->
                <div id="aside-second">
                    {% render_section "AsideRight", required: false %}
                </div
                <div class="clear"></div>
            </div>
        </div>

        <!-- ===== Footer ===== -->
        <div id="layout-footer">
            <div class="credits">
                &copy; {{ "now" | date: "%Y" }} Silver Lining Computing.
                {% render_section "Footer", required: false %}
            </div>
        </div>

    </div>
    {% render_section "FootScript", required: false %}
</body>
</html>
